{# Horizons in configured order, each listing its entities in sequence.
   The order here is the roadmap file's order — no sorting, because the
   sequence *is* the fact being recorded. #}
# Roadmap

{% for roadmap in roadmaps.values() %}
{% if roadmaps | length > 1 %}
## {{ roadmap.spec.title }}
{% endif %}
{% if roadmap.error %}
> Could not be read: {{ roadmap.error }}
{% else %}
{% for horizon in roadmap.spec.horizons %}
### {{ horizon }}

{% if not roadmap.entries(horizon) %}
_empty_
{% else %}
{% for id_text in roadmap.entries(horizon) %}
{% set entity = store.by_text(id_text) %}
{% if entity %}
- {{ entity.id.text }} — {{ entity.title }} _({{ entity.status }})_
{% else %}
- {{ id_text }} (missing)
{% endif %}
{% endfor %}
{% endif %}

{% endfor %}
{% endif %}
{% endfor %}
{% include "views/_broken.md.j2" %}
