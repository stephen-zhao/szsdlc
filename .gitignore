*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
# Venvs are not portable across the Windows/WSL boundary — a separate one per
# platform is normal here (e.g. .venv on Windows, .venv-wsl under Linux).
.venv*/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch
*.tmp
.tmp-*
